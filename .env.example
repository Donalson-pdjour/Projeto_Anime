FLASK_SECRET_KEY=
FLASK_DEBUG=false
SESSION_COOKIE_SECURE=false
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=anime_mania
MYSQL_USER=root
MYSQL_PASSWORD=

# ---------------------------------------------------------------------------
# Configuração de e-mail para recuperação de senha
# ---------------------------------------------------------------------------
#
# OPÇÃO 1 — Gmail (recomendado)
#   1. Acesse sua Conta Google → Segurança → Verificação em duas etapas
#      e ative caso ainda não esteja ativa.
#   2. Em Segurança → "Senhas de app", gere uma senha para "Outro (nome personalizado)".
#      Você receberá 16 caracteres (ex: abcd efgh ijkl mnop).
#   3. Preencha as variáveis abaixo com seu e-mail do Gmail e a senha de app gerada.
#
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=abcdefghijklmnop
MAIL_DEFAULT_SENDER=seu-email@gmail.com
#
# OPÇÃO 2 — Desenvolvimento local (sem enviar e-mail de verdade)
#   Deixe MAIL_SERVER em branco. O link de recuperação será apenas
#   exibido no console/log da aplicação, o que é suficiente para testar.
#
# MAIL_SERVER=
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USE_SSL=false
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=no-reply@anime-mania.local
